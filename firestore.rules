rules_version = '2';

// Daily — reglas de seguridad de Cloud Firestore.
// Modelo (etapa 2): los datos de cada usuario viven en UN documento: users/{uid}.
// Regla de oro: cada usuario autenticado solo puede leer/escribir SU propio documento.
// Todo lo que no esté explícitamente permitido queda DENEGADO por defecto.
service cloud.firestore {
  match /databases/{database}/documents {

    // El documento del usuario: users/{uid}. `uid` es el id del documento; tiene que coincidir
    // con el uid del que hace la solicitud, y tiene que estar autenticado.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Defensivo: si en el futuro colgamos subcolecciones del usuario (agenda, gimnasio,
      // hábitos, peso, rutinas, config…), heredan exactamente la misma regla por-uid.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Cualquier otra ruta (otro usuario, colecciones sueltas, listados) cae en el deny por
    // defecto: sin match, no hay acceso.
  }
}
